generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
}

model AcademicTerm {
  id          Int        @id @default(autoincrement())
  semester    String     // e.g., "First Semester", "Second Semester", "Summer"
  school_year String     // e.g., "2026-2027"
  is_active   Boolean    @default(true) // Only one term should be active at a time
  createdAt   DateTime   @default(now())

  schedules   Schedule[]
}

model User {
  id       Int    @id @default(autoincrement())
  user_id  String @unique 
  password String 
  name     String 
  role     Role   @default(TEACHER)
  
  schedules Schedule[]
}

model Schedule {
  id             Int       @id @default(autoincrement())
  lab_room       String
  date           String
  schedule       String
  course_code    String
  section        String

  active_pin     String?
  pin_expires_at DateTime?

  teacher_id     Int?
  teacher        User?     @relation(fields: [teacher_id], references: [id])
  attendances    AttendanceLog[]
  term_id        Int
  academic_term  AcademicTerm @relation(fields: [term_id], references: [id])
  is_archived    Boolean      @default(false)
}

model Student {
  id            Int             @id @default(autoincrement())
  student_id    String          @unique
  email         String          @unique
  first_name    String
  last_name     String
  public_key    String          
  session_token String?
  recovery_pin  String          
  attendances   AttendanceLog[]
}

model AttendanceLog {
  id          Int      @id @default(autoincrement())
  student_id  String
  schedule_id Int
  timestamp   DateTime @default(now())
  status      String   @default("ON_TIME")
  signature   String         

  student     Student  @relation(fields: [student_id], references: [student_id])
  schedule    Schedule @relation(fields: [schedule_id], references: [id])

  @@unique([student_id, schedule_id]) 
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actor     String   @default("MASTER_ADMIN")
  details   String
  target    String?
  timestamp DateTime @default(now())
}